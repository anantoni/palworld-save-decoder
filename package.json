{
  "name": "palworld-save-decoder",
  "version": "1.0.0",
  "description": "Read the Pals (level, IVs, souls, passives, condenser stars) from your own Palworld Level.sav, in the browser or Node. Includes an Oodle (ooz) decompressor compiled to WebAssembly.",
  "type": "module",
  "main": "js/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": { "types": "./types/index.d.ts", "default": "./js/index.mjs" },
    "./save": "./js/save.mjs",
    "./ooz": "./js/ooz.mjs",
    "./ooz.wasm": "./dist/ooz.wasm"
  },
  "bin": { "palworld-pals": "bin/palworld-pals.mjs" },
  "files": ["js/", "bin/", "types/", "dist/ooz.wasm", "dist/ooz.wasm.license", "src/", "build.sh", "verify.sh", "SHA256SUMS", "LICENSE", "LICENSE-MIT", "README.md", "CHANGELOG.md"],
  "engines": { "node": ">=18" },
  "license": "(MIT AND GPL-3.0-only)",
  "author": "Anastasios Antoniadis <anantoni@lorearmory.com> (https://lorearmory.com)",
  "homepage": "https://lorearmory.com/palworld/iv-calculator/",
  "repository": { "type": "git", "url": "git+https://github.com/anantoni/palworld-save-decoder.git" },
  "bugs": { "url": "https://github.com/anantoni/palworld-save-decoder/issues" },
  "keywords": ["palworld", "save", "level.sav", "pal", "iv", "ivs", "gvas", "oodle", "wasm", "save-reader"],
  "scripts": { "build": "./build.sh", "verify": "./verify.sh", "test": "node --test test/*.test.mjs" }
}
